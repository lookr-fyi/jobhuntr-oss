{
  "name": "jobhuntr-oss",
  "version": "0.10.0",
  "private": false,
  "description": "Self-contained open-source JobHuntr: local-first job search CRM, resume/cover-letter assistant, and autonomous hunt simulator.",
  "type": "module",
  "scripts": {
    "jobhuntr": "node scripts/one-line-run.mjs",
    "dev": "concurrently -n API,WEB -c cyan,magenta \"node --watch server/index.mjs\" \"vite --host 127.0.0.1\"",
    "start": "node server/index.mjs",
    "build": "vite build",
    "preview": "NODE_ENV=production node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "secret:scan": "node scripts/secret-scan.mjs",
    "verify": "npm run secret:scan && npm run format:check && npm run lint && npm test && npm run build",
    "format": "prettier --write \"**/*.{js,mjs,jsx,json,css,md,yml}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,jsx,json,css,md,yml}\"",
    "lint": "eslint . --max-warnings=0"
  },
  "keywords": [
    "jobs",
    "job-search",
    "career",
    "crm",
    "resume",
    "cover-letter",
    "local-first"
  ],
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "latest",
    "lucide-react": "latest",
    "nanoid": "latest",
    "react": "latest",
    "react-dom": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "vite": "^8.2.1"
  }
}
