{
  "name": "jobhuntr-oss",
  "version": "0.4.0",
  "private": false,
  "description": "Self-contained open-source JobHuntr: local-first job search CRM, resume/cover-letter assistant, and autonomous hunt simulator.",
  "type": "module",
  "scripts": {
    "jobhuntr": "node scripts/one-line-run.mjs",
    "dev": "concurrently -n API,WEB -c cyan,magenta \"node --watch server/index.mjs\" \"vite --host 127.0.0.1\"",
    "start": "node server/index.mjs",
    "build": "vite build",
    "preview": "NODE_ENV=production node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "secret:scan": "node scripts/secret-scan.mjs",
    "verify": "npm run secret:scan && npm test && npm run build"
  },
  "keywords": [
    "jobs",
    "job-search",
    "career",
    "crm",
    "resume",
    "cover-letter",
    "local-first"
  ],
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "typescript": "latest",
    "react": "latest",
    "react-dom": "latest",
    "lucide-react": "latest",
    "express": "latest",
    "nanoid": "latest",
    "zod": "latest",
    "concurrently": "latest"
  },
  "devDependencies": {}
}
