{
  "name": "jobhuntr-oss",
  "version": "1.0.0",
  "author": "lookr-fyi",
  "private": false,
  "description": "Self-contained local-first job search CRM, document studio, career coach, and explainable hunt engine.",
  "main": "electron/main.mjs",
  "type": "module",
  "scripts": {
    "jobhuntr": "node scripts/one-line-run.mjs",
    "desktop": "npm run build && electron electron/main.mjs",
    "dist:desktop": "npm run build && electron-builder",
    "dist:desktop:dir": "npm run build && electron-builder --dir",
    "dev": "concurrently -n API,WEB -c cyan,magenta \"node --watch server/index.mjs\" \"vite --host 127.0.0.1\"",
    "start": "node server/index.mjs",
    "build": "vite build",
    "preview": "NODE_ENV=production node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "npm run build && node --test tests/e2e/*.test.mjs",
    "secret:scan": "node scripts/secret-scan.mjs",
    "verify": "npm run secret:scan && npm run format:check && npm run lint && npm test && npm run test:e2e",
    "format": "prettier --write \"**/*.{js,mjs,jsx,json,css,md,yml}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,jsx,json,css,md,yml}\"",
    "lint": "eslint . --max-warnings=0"
  },
  "keywords": [
    "jobs",
    "job-search",
    "career",
    "crm",
    "resume",
    "cover-letter",
    "local-first"
  ],
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=20"
  },
  "build": {
    "appId": "fyi.lookr.jobhuntr",
    "productName": "JobHuntr",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "server/**/*",
      "dist/public/**/*",
      "src/jobhuntr-logo.png",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "src/jobhuntr-logo.png",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "src/jobhuntr-logo.png",
      "target": "nsis"
    },
    "linux": {
      "category": "Office",
      "icon": "src/jobhuntr-logo.png",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "dependencies": {
    "express": "latest",
    "lucide-react": "latest",
    "nanoid": "latest",
    "react": "latest",
    "react-dom": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "playwright-core": "^1.62.1",
    "prettier": "^3.9.6",
    "vite": "^8.2.1"
  }
}
